#include<stdio.h>
void main(){
	int a=10,b=5;
	int *p,*q;
	p=&a;
	q=&b;
	printf("a : %d",a);
	printf("b : %d",b);
	printf("address of a : %d",&a);
        printf("address of b : %d",&b);
        printf("address of a using pointer : %d",p);
        printf("address of b using pointer : %d",q);
	printf("a using pointer : %d",*p);
        printf("b using pointer : %d",*q);
}






